# ── Firebase Configuration ────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web app
# Without these: app runs in localStorage demo mode (single device only).
# With these:    app runs in Firestore mode (real multiplayer, realtime sync).

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Admin Emails ──────────────────────────────────────────────────────────────
# Comma-separated list of emails with admin panel access.
# These users can edit match scores, possession, corners, and status.
VITE_ADMIN_EMAILS=youremail@gmail.com,friend@gmail.com
