# ─── Supabase (required for production) ──────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google OAuth (required for real login) ───────────────────────────────────
# Configure at: https://supabase.com → Authentication → Providers → Google
# Then add your Google Client ID from Google Cloud Console
# No env var needed here — configured in Supabase dashboard

# ─── App config (optional) ────────────────────────────────────────────────────
VITE_APP_VERSION=v0.2-alpha
VITE_GROUP_ID=default
